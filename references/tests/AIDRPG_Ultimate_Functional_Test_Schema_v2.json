{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDRPG Ultimate Functional Test Case v2",
  "type": "object",
  "required": [
    "test_id",
    "category_code",
    "scenario_genre",
    "choice_group",
    "fixture_id",
    "player_input",
    "simulated_ai_output",
    "checks",
    "shard_id"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^UTM2-[A-Z]{3}-[A-Z]{3}-[A-Z]{3}-[0-9]{2}$"
    },
    "matrix_version": {
      "type": "string"
    },
    "category_code": {
      "type": "string"
    },
    "scenario_genre": {
      "type": "string"
    },
    "choice_group": {
      "type": "string"
    },
    "fixture_id": {
      "type": "string"
    },
    "player_input": {
      "type": "string",
      "minLength": 1
    },
    "simulated_ai_output": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "selector",
          "op"
        ],
        "properties": {
          "selector": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "recommended_timeout_ms": {
      "type": "integer"
    },
    "shard_id": {
      "type": "string"
    }
  }
}